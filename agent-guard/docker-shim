#!/bin/bash
# docker shim — gives every agent-launched `docker run|create` a memory ceiling (2026-11-18).
#
# WHY: containers started by `docker run` live in system.slice, OUTSIDE the IntelliJ scope cap,
# and default to NO memory limit. On 2026-11-18 a review subagent ran a mutation test
# (`MAX_LEGS = 10**9`) in `docker run yolo-rs-test` with no --memory; the python grew to ~46 GiB
# (24 resident + 22 swapped), the global OOM killer shot the k8s pods (oom_score_adj 1000)
# instead of it (adj 0), systemd-oomd killed IntelliJ, and the box froze 12 min until hard reset.
# A per-container limit makes the runaway die ALONE, inside its own cgroup.
#
# FAIL-OPEN by design: anything unrecognised is passed straight to the real docker unchanged.
# Skipped for minikube/privileged/GPU-cluster containers (capping those would cap the cluster),
# and when AGENT_DOCKER_NO_LIMIT=1. Override the ceiling with AGENT_DOCKER_MEM (default 8g).
# Not covered: `docker compose` (use mem_limit in the compose file), `docker build`.
REAL=/usr/bin/docker
[ -x "$REAL" ] || REAL=/bin/docker
MEM="${AGENT_DOCKER_MEM:-8g}"

if [ "${AGENT_DOCKER_NO_LIMIT:-0}" = 1 ] || [ "$(ps -o comm= -p "$PPID" 2>/dev/null)" = minikube ]; then exec "$REAL" "$@"; fi

# find subcommand (first non-option arg); `container run|create` counts too
sub="" idx=0 i=0
for a in "$@"; do
  i=$((i+1))
  case "$a" in -*) continue;; esac
  sub="$a"; idx=$i; break
done
if [ "$sub" = container ] && { [ "${*:$((idx+1)):1}" = run ] || [ "${*:$((idx+1)):1}" = create ]; }; then idx=$((idx+1)); sub=run; fi
case "$sub" in run|create) ;; *) exec "$REAL" "$@";; esac

has_mem=0 has_swap=0 skip=0
for a in "${@:$((idx+1))}"; do
  case "$a" in
    -m|-m=*|--memory|--memory=*) has_mem=1;;
    --memory-swap|--memory-swap=*) has_swap=1;;
    --privileged|--name=minikube|*minikube.sigs.k8s.io*|--gpus|--gpus=*|--runtime=nvidia) skip=1;;
    minikube) skip=1;;
  esac
done
{ [ $skip = 1 ] || [ $has_mem = 1 ]; } && exec "$REAL" "$@"

inject=("--memory=$MEM")
[ $has_swap = 0 ] && inject+=("--memory-swap=$MEM")   # swap == mem => no swap, fails fast instead of thrashing
# shared budget across ALL agent containers (root-installed slice; harmless to omit)
[ -f /etc/systemd/system/agent-docker.slice ] && inject+=("--cgroup-parent=agent-docker.slice")
exec "$REAL" "${@:1:$idx}" "${inject[@]}" "${@:$((idx+1))}"
